# ------------------------------------------------------------------
# Planora – environment variables (EXAMPLE / PLACEHOLDERS ONLY)
# Copy this file to `.env.local` and fill in real values there.
# NEVER commit `.env.local` or any real secrets.
# ------------------------------------------------------------------

# --- Database (Neon PostgreSQL) ---
# Pooled connection string – used by the application at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/planora?sslmode=require"
# Direct connection string – used for Prisma migrations / schema engine.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/planora?sslmode=require"

# --- Authentication (Auth.js v5 / NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app (http://localhost:3000 in development).
AUTH_URL="http://localhost:3000"

# --- Initial administrator seed (used only by prisma/seed.ts) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_FIRST_NAME=""
SEED_ADMIN_LAST_NAME=""
SEED_ADMIN_PASSWORD=""

# Password for the seeded demo users (prisma/demo-seed.ts). Active demo users are
# created with this password (hashed) and must change it on first login.
SEED_DEMO_PASSWORD=""
